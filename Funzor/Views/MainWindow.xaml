<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Funzor.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Funzor.Views.Shell"
    Title="Funzor">

    <Grid Background="{ThemeResource Foundation.Canvas.Background}">

        <Grid.ColumnDefinitions>
            <!-- 布局常量: 56 为一级导航, 240 为二级菜单, 其余给内容 -->
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <shell:NavigationRail
            x:Name="Rail"
            SectionSelected="Rail_SectionSelected" />

        <shell:SectionPanel
            x:Name="Panel"
            Grid.Column="1"
            EntrySelected="Panel_EntrySelected" />

        <Frame
            x:Name="ContentFrame"
            Grid.Column="2"
            Background="{ThemeResource Content.Background}" />

    </Grid>
</Window>
