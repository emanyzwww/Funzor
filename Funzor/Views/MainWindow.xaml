<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Funzor.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Funzor.Views.Shell"
    Title="Funzor">

    <Grid Background="{ThemeResource Foundation.Canvas.Background}">

        <Grid.ColumnDefinitions>
            <!-- 布局常量: 56 为一级导航, 240 为二级菜单, 其余给内容 -->
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- 布局常量: 48 为自定义标题栏高度 -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 一级导航仍然占满窗口高度: 标题栏只覆盖第 1-2 列 -->
        <shell:NavigationRail
            x:Name="Rail"
            Grid.RowSpan="2"
            Grid.Column="0"
            SectionSelected="Rail_SectionSelected" />

        <shell:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2" />

        <shell:SectionPanel
            x:Name="Panel"
            Grid.Row="1"
            Grid.Column="1"
            EntrySelected="Panel_EntrySelected" />

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Grid.Column="2"
            Background="{ThemeResource Content.Background}" />

    </Grid>
</Window>
