<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Funzor.Views.Shell.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Funzor.Helpers"
    xmlns:nav="using:Funzor.Navigation">

    <UserControl.Resources>
        <!--
            一级导航的列表项样式 (圆角 / 悬停 / 选中) 由 Controls/Navigation/PrimaryNavList.xaml 自己定义,
            不覆盖 WinUI 的 ListViewItem* 原生资源. 该字典只合并到本列表.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/Navigation/PrimaryNavList.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:ResourceKeyToTemplateConverter x:Key="IconKeyToTemplateConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource PrimaryNav.Background}">
        <ListView
            x:Name="SectionList"
            Width="56"
            MinWidth="0"
            Padding="0,8,0,8"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            HorizontalAlignment="Left"
            ItemContainerStyle="{StaticResource PrimaryNavItemStyle}"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="SectionList_SelectionChanged"
            ContainerContentChanging="SectionList_ContainerContentChanging">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="nav:NavSection">
                    <Grid
                        Height="40"
                        AutomationProperties.Name="{x:Bind Title}"
                        ToolTipService.ToolTip="{x:Bind Title}">
                        <!-- 图标来自 Icons.xaml 的 ControlTemplate. 模型只保存资源 key. -->
                        <ContentControl
                            x:Name="NavIcon"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource PrimaryNav.Item.Foreground}"
                            IsTabStop="False"
                            Template="{x:Bind IconKey, Converter={StaticResource IconKeyToTemplateConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
