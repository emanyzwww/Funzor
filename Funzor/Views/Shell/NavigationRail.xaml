<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Funzor.Views.Shell.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Funzor.Helpers"
    xmlns:nav="using:Funzor.Navigation">

    <UserControl.Resources>
        <!--
            一级导航是固定深色区域. 局部别名把 WinUI ListViewItem 状态键映射到 PrimaryNav.*.
            别名只作用于当前 ListView, 不污染其他列表.
        -->
        <ResourceDictionary>
            <helpers:ResourceKeyToTemplateConverter x:Key="IconKeyToTemplateConverter" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver"
                                    ResourceKey="PrimaryNav.Item.Background.Hover" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed"
                                    ResourceKey="PrimaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemBackgroundSelected"
                                    ResourceKey="PrimaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver"
                                    ResourceKey="PrimaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed"
                                    ResourceKey="PrimaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemForeground" ResourceKey="PrimaryNav.Item.Foreground" />
                    <StaticResource x:Key="ListViewItemForegroundPointerOver"
                                    ResourceKey="PrimaryNav.Item.Foreground.Hover" />
                    <StaticResource x:Key="ListViewItemForegroundSelected"
                                    ResourceKey="PrimaryNav.Item.Foreground.Selected" />
                    <StaticResource x:Key="ListViewItemFocusVisualPrimaryBrush" ResourceKey="PrimaryNav.Focus.Ring" />
                    <StaticResource x:Key="ListViewItemFocusVisualSecondaryBrush" ResourceKey="PrimaryNav.Focus.Offset" />
                    <StaticResource x:Key="ListViewItemFocusBorderBrush" ResourceKey="PrimaryNav.Focus.Ring" />
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver"
                                    ResourceKey="PrimaryNav.Item.Background.Hover" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed"
                                    ResourceKey="PrimaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemBackgroundSelected"
                                    ResourceKey="PrimaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver"
                                    ResourceKey="PrimaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed"
                                    ResourceKey="PrimaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemForeground" ResourceKey="PrimaryNav.Item.Foreground" />
                    <StaticResource x:Key="ListViewItemForegroundPointerOver"
                                    ResourceKey="PrimaryNav.Item.Foreground.Hover" />
                    <StaticResource x:Key="ListViewItemForegroundSelected"
                                    ResourceKey="PrimaryNav.Item.Foreground.Selected" />
                    <StaticResource x:Key="ListViewItemFocusVisualPrimaryBrush" ResourceKey="PrimaryNav.Focus.Ring" />
                    <StaticResource x:Key="ListViewItemFocusVisualSecondaryBrush" ResourceKey="PrimaryNav.Focus.Offset" />
                    <StaticResource x:Key="ListViewItemFocusBorderBrush" ResourceKey="PrimaryNav.Focus.Ring" />
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource PrimaryNav.Background}">
        <ListView
            x:Name="SectionList"
            Width="56"
            MinWidth="0"
            Padding="0,8,0,8"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            HorizontalAlignment="Left"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="SectionList_SelectionChanged"
            ContainerContentChanging="SectionList_ContainerContentChanging">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Margin" Value="8,2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="Foreground" Value="{ThemeResource PrimaryNav.Item.Foreground}" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="nav:NavSection">
                    <Grid
                        Height="40"
                        AutomationProperties.Name="{x:Bind Title}"
                        ToolTipService.ToolTip="{x:Bind Title}">
                        <!-- 图标来自 Icons.xaml 的 ControlTemplate. 模型只保存资源 key. -->
                        <ContentControl
                            x:Name="NavIcon"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource PrimaryNav.Item.Foreground}"
                            IsTabStop="False"
                            Template="{x:Bind IconKey, Converter={StaticResource IconKeyToTemplateConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
