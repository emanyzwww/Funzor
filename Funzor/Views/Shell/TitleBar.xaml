<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Funzor.Views.Shell.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                标题栏按钮使用局部别名把 WinUI Button 的状态键映射到 TitleBar.*,
                与导航栏的 ListViewItem 别名模式一致, 不重写 Button 模板.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ButtonBackground"
                                    ResourceKey="TitleBar.Button.Background" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver"
                                    ResourceKey="TitleBar.Button.Background.Hover" />
                    <StaticResource x:Key="ButtonBackgroundPressed"
                                    ResourceKey="TitleBar.Button.Background.Pressed" />
                    <StaticResource x:Key="ButtonForeground"
                                    ResourceKey="TitleBar.Button.Foreground" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ButtonBackground"
                                    ResourceKey="TitleBar.Button.Background" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver"
                                    ResourceKey="TitleBar.Button.Background.Hover" />
                    <StaticResource x:Key="ButtonBackgroundPressed"
                                    ResourceKey="TitleBar.Button.Background.Pressed" />
                    <StaticResource x:Key="ButtonForeground"
                                    ResourceKey="TitleBar.Button.Foreground" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="{StaticResource A.Size.32}" />
                <Setter Property="Height" Value="{StaticResource A.Size.32}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource A.Radius.6}" />
                <Setter Property="Background" Value="{ThemeResource TitleBar.Button.Background}" />
                <Setter Property="Foreground" Value="{ThemeResource TitleBar.Button.Foreground}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{ThemeResource TitleBar.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="TitleText"
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TitleBar.Title.Foreground}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Funzor"
            TextTrimming="CharacterEllipsis" />

        <StackPanel
            Grid.Column="1"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                x:Name="MinimizeButton"
                AutomationProperties.Name="最小化"
                Click="MinimizeButton_Click"
                Style="{StaticResource TitleBarButtonStyle}"
                ToolTipService.ToolTip="最小化">
                <ContentControl
                    Width="20"
                    Height="20"
                    Foreground="{ThemeResource TitleBar.Button.Foreground}"
                    IsHitTestVisible="False"
                    Template="{StaticResource Icon.Minimize}" />
            </Button>

            <Button
                x:Name="CloseButton"
                AutomationProperties.Name="关闭"
                Click="CloseButton_Click"
                Style="{StaticResource TitleBarButtonStyle}"
                ToolTipService.ToolTip="关闭">
                <ContentControl
                    Width="20"
                    Height="20"
                    Foreground="{ThemeResource TitleBar.Button.Foreground}"
                    IsHitTestVisible="False"
                    Template="{StaticResource Icon.Close}" />
            </Button>
        </StackPanel>

        <Border
            Grid.ColumnSpan="2"
            Height="{StaticResource A.Size.1}"
            VerticalAlignment="Bottom"
            Background="{ThemeResource TitleBar.Separator}"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
