<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Funzor.Views.Shell.SectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Funzor.Navigation">

    <UserControl.Resources>
        <!--
            二级菜单跟随主题. 局部别名把 WinUI ListViewItem 状态键映射到 SecondaryNav.*.
            不覆盖全局 ListViewItem 键, 避免污染内容区列表.
        -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver"
                                    ResourceKey="SecondaryNav.Item.Background.Hover" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed"
                                    ResourceKey="SecondaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemBackgroundSelected"
                                    ResourceKey="SecondaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver"
                                    ResourceKey="SecondaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed"
                                    ResourceKey="SecondaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemForeground" ResourceKey="SecondaryNav.Item.Foreground" />
                    <StaticResource x:Key="ListViewItemForegroundPointerOver"
                                    ResourceKey="SecondaryNav.Item.Foreground.Hover" />
                    <StaticResource x:Key="ListViewItemForegroundSelected"
                                    ResourceKey="SecondaryNav.Item.Foreground.Selected" />
                    <StaticResource x:Key="ListViewItemFocusVisualPrimaryBrush" ResourceKey="SecondaryNav.Focus.Ring" />
                    <StaticResource x:Key="ListViewItemFocusVisualSecondaryBrush"
                                    ResourceKey="SecondaryNav.Focus.Offset" />
                    <StaticResource x:Key="ListViewItemFocusBorderBrush" ResourceKey="SecondaryNav.Focus.Ring" />
                    <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver"
                                    ResourceKey="SecondaryNav.Item.Background.Hover" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed"
                                    ResourceKey="SecondaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemBackgroundSelected"
                                    ResourceKey="SecondaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver"
                                    ResourceKey="SecondaryNav.Item.Background.Selected" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed"
                                    ResourceKey="SecondaryNav.Item.Background.Pressed" />
                    <StaticResource x:Key="ListViewItemForeground" ResourceKey="SecondaryNav.Item.Foreground" />
                    <StaticResource x:Key="ListViewItemForegroundPointerOver"
                                    ResourceKey="SecondaryNav.Item.Foreground.Hover" />
                    <StaticResource x:Key="ListViewItemForegroundSelected"
                                    ResourceKey="SecondaryNav.Item.Foreground.Selected" />
                    <StaticResource x:Key="ListViewItemFocusVisualPrimaryBrush" ResourceKey="SecondaryNav.Focus.Ring" />
                    <StaticResource x:Key="ListViewItemFocusVisualSecondaryBrush"
                                    ResourceKey="SecondaryNav.Focus.Offset" />
                    <StaticResource x:Key="ListViewItemFocusBorderBrush" ResourceKey="SecondaryNav.Focus.Ring" />
                    <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource SecondaryNav.Background}"
        BorderBrush="{ThemeResource SecondaryNav.Separator}"
        BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PanelTitle"
            Margin="16,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource SecondaryNav.Header.Foreground}"
            Style="{StaticResource BodyStrongTextBlockStyle}" />

        <ListView
            x:Name="EntryList"
            Grid.Row="1"
            Padding="0,4,0,8"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="EntryList_SelectionChanged">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Margin" Value="8,1" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="Foreground" Value="{ThemeResource SecondaryNav.Item.Foreground}" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="nav:NavEntry">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
