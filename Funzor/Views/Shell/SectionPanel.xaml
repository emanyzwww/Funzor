<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="Funzor.Views.Shell.SectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Funzor.Navigation">

    <UserControl.Resources>
        <!--
            二级菜单的列表项样式 (圆角 / 悬停 / 选中) 由 Controls/Navigation/SecondaryNavList.xaml 自己定义,
            不覆盖 WinUI 的 ListViewItem* 原生资源. 该字典只合并到本列表.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/Navigation/SecondaryNavList.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource SecondaryNav.Background}"
        BorderBrush="{ThemeResource SecondaryNav.Separator}"
        BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="PanelTitle"
            Margin="16,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource SecondaryNav.Header.Foreground}"
            Style="{StaticResource BodyStrongTextBlockStyle}" />

        <ListView
            x:Name="EntryList"
            Grid.Row="1"
            Padding="0,4,0,8"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource SecondaryNavItemStyle}"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="EntryList_SelectionChanged">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="nav:NavEntry">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
