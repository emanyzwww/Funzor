<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Funzor.Views.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer">

    <Grid
        Padding="32"
        Background="{ThemeResource Content.Background}">
        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="16">

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource PageTitleTextBlockStyle}" />

            <TextBlock
                Text="占位页面: 页面内容稍后在这里实现."
                Style="{StaticResource PageDescriptionTextBlockStyle}" />

            <!-- 更新入口临时放在占位页, 后续迁到独立的设置/更新页面 -->
            <Button
                x:Name="UpdateCheckButton"
                l:Uids.Uid="UpdateCheckButton"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="UpdateCheckButton_Click" />
        </StackPanel>
    </Grid>
</Page>
