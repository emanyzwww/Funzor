<?xml version="1.0" encoding="utf-8"?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        图标模板.
        源 SVG 和模板内部坐标统一为 256 viewBox.
        Viewbox 不写死尺寸, 由使用方的 ContentControl 决定最终显示大小.
        Fill 图标用 Fill, Stroke 图标用 Stroke; 颜色都通过 TemplateBinding Foreground 传入.
    -->

    <!-- Settings 图标: 256 viewBox, stroke. -->
    <ControlTemplate x:Key="Icon.Settings" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="256" Height="256">
                <Path
                    Data="M41.43,178.09A99.14,99.14,0,0,1,31.36,153.8l16.78-21a81.59,81.59,0,0,1,0-9.64l-16.77-21a99.43,99.43,0,0,1,10.05-24.3l26.71-3a81,81,0,0,1,6.81-6.81l3-26.7A99.14,99.14,0,0,1,102.2,31.36l21,16.78a81.59,81.59,0,0,1,9.64,0l21-16.77a99.43,99.43,0,0,1,24.3,10.05l3,26.71a81,81,0,0,1,6.81,6.81l26.7,3a99.14,99.14,0,0,1,10.07,24.29l-16.78,21a81.59,81.59,0,0,1,0,9.64l16.77,21a99.43,99.43,0,0,1-10,24.3l-26.71,3a81,81,0,0,1-6.81,6.81l-3,26.7a99.14,99.14,0,0,1-24.29,10.07l-21-16.78a81.59,81.59,0,0,1-9.64,0l-21,16.77a99.43,99.43,0,0,1-24.3-10l-3-26.71a81,81,0,0,1-6.81-6.81Z"
                    Fill="{x:Null}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeThickness="16" />
                <Ellipse
                    Width="80"
                    Height="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{x:Null}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="16" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <!-- Minimize 图标: 256 viewBox, stroke. -->
    <ControlTemplate x:Key="Icon.Minimize" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="256" Height="256">
                <Path
                    Data="M144 64 L144 112 L192 112 M208 48 L144 112 M64 144 L112 144 L112 192 M48 208 L112 144"
                    Fill="{x:Null}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeThickness="16" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <!-- Close 图标: 256 viewBox, stroke. -->
    <ControlTemplate x:Key="Icon.Close" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="256" Height="256">
                <Path
                    Data="M200 56 L56 200 M200 200 L56 56"
                    Fill="{x:Null}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeThickness="16" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>
