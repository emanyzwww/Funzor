<?xml version="1.0" encoding="utf-8"?>

<!--
    系统控件重设
    只改尺寸 / 圆角 / 排版, 不改模板: 模板一旦重写, WinUI 后续的模板修复就吃不到了.
    颜色全部引用 Theme.Light / Theme.Dark 里的语义键.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面标题: 24 / 32, 每页一个 -->
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.24}" />
        <Setter Property="LineHeight" Value="{StaticResource A.LineHeight.32}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource Foundation.Text.Primary}" />
    </Style>

    <!-- 页面描述: 14 / 20 -->
    <Style x:Key="PageDescriptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.14}" />
        <Setter Property="LineHeight" Value="{StaticResource A.LineHeight.20}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource Foundation.Text.Secondary}" />
    </Style>

    <!-- 小节标题: 20 / 28 -->
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.20}" />
        <Setter Property="LineHeight" Value="{StaticResource A.LineHeight.28}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource Foundation.Text.Primary}" />
    </Style>

    <!-- 正文: 14 / 20 -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.14}" />
        <Setter Property="LineHeight" Value="{StaticResource A.LineHeight.20}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource Foundation.Text.Primary}" />
    </Style>

    <!-- 辅助说明: 12 / 16 -->
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.12}" />
        <Setter Property="LineHeight" Value="{StaticResource A.LineHeight.16}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource Foundation.Text.Secondary}" />
    </Style>

    <!-- 主按钮: 原生 AccentButtonStyle + 本项目的尺寸与圆角 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource A.Size.32}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{StaticResource A.Radius.6}" />
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 次按钮: 默认 Button + 本项目的尺寸与圆角 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource A.Size.32}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{StaticResource A.Radius.6}" />
        <Setter Property="FontSize" Value="{StaticResource A.FontSize.14}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

</ResourceDictionary>
