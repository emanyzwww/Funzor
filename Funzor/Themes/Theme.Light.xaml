<?xml version="1.0" encoding="utf-8"?>

<!--
    浅色主题语义层
    浅色下画布纯白, 基面暖白, 输入框回落成画布色.

    约束:
    1. key 集合与另一份主题文件完全一致, 顺序也保持一致, 便于逐行对照.
       缺 key 时, 对应主题下引用它的地方会在运行时找不到资源, 编译期查不出来.
    2. 只放 SolidColorBrush 与 LinearGradientBrush, 只放"会随明暗变化"的值.
       尺寸 / 间距 / 圆角 / 时长不进主题层, 它们在 Tokens.xaml 里与主题无关.
    3. 色值一律引用 Tokens.xaml 的 A.*, 本文件不出现十六进制.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 表面 -->
    <!-- 画布 / 基面 / 软表面 / 抬升 / 凹陷 五级层次. 深色下软表面与基面同值, 色阶分不出更细的差. -->
    <SolidColorBrush x:Key="Surface.Canvas.Background" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Surface.Base.Background" Color="{StaticResource A.Neutral.100}" />
    <SolidColorBrush x:Key="Surface.Soft.Background" Color="{StaticResource A.Neutral.50}" />
    <SolidColorBrush x:Key="Surface.Raised.Background" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Surface.Sunken.Background" Color="{StaticResource A.Neutral.150}" />
    <SolidColorBrush x:Key="Surface.Inverse.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Surface.Hover.Background" Color="{StaticResource A.Black.A04}" />
    <SolidColorBrush x:Key="Surface.Selected.Background" Color="{StaticResource A.Blue.50}" />
    <SolidColorBrush x:Key="Surface.Disabled.Background" Color="{StaticResource A.Neutral.150}" />
    <SolidColorBrush x:Key="Surface.Code.Background" Color="{StaticResource A.Neutral.150}" />
    <SolidColorBrush x:Key="Surface.Tooltip.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Surface.Input.Background" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Surface.InputDisabled.Background" Color="{StaticResource A.Neutral.150}" />
    <SolidColorBrush x:Key="Surface.PreviewBanner.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Surface.Scrim.Background" Color="{StaticResource A.Black.A40}" />

    <!-- 文字 -->
    <!-- 浅色正文 900, 次要 650, 三级 600, 弱 550, 禁用 350; 深色整体反向. -->
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource A.Neutral.650}" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="{StaticResource A.Neutral.600}" />
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource A.Neutral.550}" />
    <SolidColorBrush x:Key="Text.Disabled" Color="{StaticResource A.Neutral.350}" />
    <SolidColorBrush x:Key="Text.Inverse" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Text.OnAction" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Text.OnGradient" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Text.Link" Color="{StaticResource A.Blue.600}" />
    <SolidColorBrush x:Key="Text.Link.Hover" Color="{StaticResource A.Blue.700}" />
    <SolidColorBrush x:Key="Text.Emphasis" Color="{StaticResource A.Coral.700}" />
    <SolidColorBrush x:Key="Text.Code" Color="{StaticResource A.Neutral.700}" />
    <SolidColorBrush x:Key="Text.OnTooltip" Color="{StaticResource A.Neutral.0}" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="Border.Default" Color="{StaticResource A.Neutral.250}" />
    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource A.Neutral.200}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource A.Neutral.300}" />
    <SolidColorBrush x:Key="Border.Focus" Color="{StaticResource A.Blue.500}" />
    <SolidColorBrush x:Key="Border.Disabled" Color="{StaticResource A.Neutral.200}" />
    <SolidColorBrush x:Key="Border.Control" Color="{StaticResource A.Neutral.250}" />
    <SolidColorBrush x:Key="Border.Control.Hover" Color="{StaticResource A.Neutral.300}" />

    <!-- 动作 -->
    <!-- 主按钮用墨黑, 不用珊瑚. 珊瑚是品牌识别色, 不承担按钮底色. -->
    <SolidColorBrush x:Key="Action.Primary.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Action.Primary.Background.Hover" Color="{StaticResource A.Neutral.750}" />
    <SolidColorBrush x:Key="Action.Primary.Background.Pressed" Color="{StaticResource A.Neutral.700}" />
    <SolidColorBrush x:Key="Action.Primary.Foreground" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Action.Secondary.Border" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Action.Secondary.Foreground" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Action.Secondary.Hover.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Action.Secondary.Hover.Foreground" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Action.Ghost.Foreground" Color="{StaticResource A.Neutral.700}" />
    <SolidColorBrush x:Key="Action.Ghost.Hover.Background" Color="{StaticResource A.Neutral.100}" />
    <SolidColorBrush x:Key="Action.Danger.Background" Color="{StaticResource A.Red.500}" />
    <SolidColorBrush x:Key="Action.Danger.Background.Hover" Color="{StaticResource A.Red.600}" />
    <SolidColorBrush x:Key="Action.Danger.Foreground" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Action.DangerSoft.Background" Color="{StaticResource A.Red.50}" />
    <SolidColorBrush x:Key="Action.DangerSoft.Foreground" Color="{StaticResource A.Red.600}" />
    <SolidColorBrush x:Key="Action.OnGradient" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Action.OnGradient.Line" Color="{StaticResource A.White.A40}" />
    <SolidColorBrush x:Key="Action.Disabled.Background" Color="{StaticResource A.Neutral.150}" />
    <SolidColorBrush x:Key="Action.Disabled.Foreground" Color="{StaticResource A.Neutral.350}" />

    <!-- 状态 -->
    <!-- 四态各出 文字 / 底色 / 描边 / 实心 四种用法, 语义由主题层绑定到色相. -->
    <SolidColorBrush x:Key="Status.Success.Text" Color="{StaticResource A.Green.500}" />
    <SolidColorBrush x:Key="Status.Success.Background" Color="{StaticResource A.Green.50}" />
    <SolidColorBrush x:Key="Status.Success.Border" Color="{StaticResource A.Green.200}" />
    <SolidColorBrush x:Key="Status.Success.Solid" Color="{StaticResource A.Green.500}" />
    <SolidColorBrush x:Key="Status.Warn.Text" Color="{StaticResource A.Amber.600}" />
    <SolidColorBrush x:Key="Status.Warn.Background" Color="{StaticResource A.Amber.50}" />
    <SolidColorBrush x:Key="Status.Warn.Border" Color="{StaticResource A.Amber.200}" />
    <SolidColorBrush x:Key="Status.Warn.Solid" Color="{StaticResource A.Amber.500}" />
    <SolidColorBrush x:Key="Status.Danger.Text" Color="{StaticResource A.Red.600}" />
    <SolidColorBrush x:Key="Status.Danger.Background" Color="{StaticResource A.Red.50}" />
    <SolidColorBrush x:Key="Status.Danger.Border" Color="{StaticResource A.Red.200}" />
    <SolidColorBrush x:Key="Status.Danger.Solid" Color="{StaticResource A.Red.500}" />
    <SolidColorBrush x:Key="Status.Info.Text" Color="{StaticResource A.Blue.600}" />
    <SolidColorBrush x:Key="Status.Info.Background" Color="{StaticResource A.Blue.50}" />
    <SolidColorBrush x:Key="Status.Info.Border" Color="{StaticResource A.Blue.200}" />
    <SolidColorBrush x:Key="Status.Info.Solid" Color="{StaticResource A.Blue.600}" />
    <SolidColorBrush x:Key="Status.Neutral.Text" Color="{StaticResource A.Neutral.600}" />
    <SolidColorBrush x:Key="Status.Neutral.Background" Color="{StaticResource A.Neutral.100}" />
    <SolidColorBrush x:Key="Status.Neutral.Border" Color="{StaticResource A.Neutral.250}" />

    <!-- 外壳 -->
    <!-- 左侧深色导轨 + 浅色工具面板 + 半透明顶栏, 两个主题都保留这套骨架. -->
    <SolidColorBrush x:Key="Shell.Rail.Background" Color="{StaticResource A.Neutral.950}" />
    <SolidColorBrush x:Key="Shell.Rail.Foreground" Color="{StaticResource A.Neutral.50}" />
    <SolidColorBrush x:Key="Shell.Rail.Muted" Color="{StaticResource A.Neutral.450}" />
    <SolidColorBrush x:Key="Shell.Rail.Hover" Color="{StaticResource A.White.A08}" />
    <SolidColorBrush x:Key="Shell.Rail.Active.Background" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Shell.Rail.Active.Foreground" Color="{StaticResource A.Neutral.950}" />
    <SolidColorBrush x:Key="Shell.Panel.Background" Color="{StaticResource A.Neutral.50}" />
    <SolidColorBrush x:Key="Shell.Panel.Foreground" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Shell.Panel.Active.Background" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Shell.Panel.Active.Border" Color="{StaticResource A.Neutral.250}" />
    <SolidColorBrush x:Key="Shell.TopBar.Background" Color="{StaticResource A.White.A80}" />
    <SolidColorBrush x:Key="Shell.TopBar.Border" Color="{StaticResource A.Neutral.250}" />
    <SolidColorBrush x:Key="Shell.Banner.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Shell.Banner.Foreground" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Shell.Avatar.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Shell.Avatar.Foreground" Color="{StaticResource A.Neutral.0}" />

    <!-- 图表 -->
    <SolidColorBrush x:Key="Chart.1" Color="{StaticResource A.Blue.500}" />
    <SolidColorBrush x:Key="Chart.2" Color="{StaticResource A.Purple.500}" />
    <SolidColorBrush x:Key="Chart.3" Color="{StaticResource A.Coral.500}" />
    <SolidColorBrush x:Key="Chart.4" Color="{StaticResource A.Cyan.500}" />
    <SolidColorBrush x:Key="Chart.5" Color="{StaticResource A.Green.500}" />
    <SolidColorBrush x:Key="Chart.6" Color="{StaticResource A.Magenta.500}" />
    <SolidColorBrush x:Key="Chart.Grid" Color="{StaticResource A.Neutral.200}" />
    <SolidColorBrush x:Key="Chart.Axis" Color="{StaticResource A.Neutral.550}" />
    <SolidColorBrush x:Key="Chart.Tooltip.Background" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="Chart.Tooltip.Foreground" Color="{StaticResource A.Neutral.0}" />

    <!-- 焦点与选中 -->
    <SolidColorBrush x:Key="Focus.Ring" Color="{StaticResource A.Blue.500}" />
    <SolidColorBrush x:Key="Focus.Offset" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="Selection.Background" Color="{StaticResource A.Coral.50}" />

    <!-- 渐变: 品牌产品卡 / 重点区块 -->
    <LinearGradientBrush x:Key="Gradient.Coral" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="{StaticResource A.Coral.400}" Offset="0" />
        <GradientStop Color="{StaticResource A.Coral.600}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Magenta" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="{StaticResource A.Magenta.400}" Offset="0" />
        <GradientStop Color="{StaticResource A.Magenta.600}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Blue" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="{StaticResource A.Blue.400}" Offset="0" />
        <GradientStop Color="{StaticResource A.Blue.600}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Purple" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="{StaticResource A.Purple.400}" Offset="0" />
        <GradientStop Color="{StaticResource A.Purple.600}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient.Ink" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="{StaticResource A.Neutral.700}" Offset="0" />
        <GradientStop Color="{StaticResource A.Neutral.950}" Offset="1" />
    </LinearGradientBrush>

    <!--
        WinUI 内置键覆盖
        覆盖这些键, 原生控件 (Button / TextBox / ListView / ScrollBar / ToggleSwitch) 才会跟着这套色走,
        否则会和 Fluent 默认的灰蓝混在一起.
        这些键属于 WinUI 内部约定, 升级 WindowsAppSDK 时需要复核一遍.
    -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource A.Neutral.650}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource A.Neutral.600}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource A.Neutral.350}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource A.Neutral.0}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource A.Neutral.250}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource A.Neutral.200}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource A.Coral.500}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource A.Coral.400}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource A.Coral.600}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource A.Neutral.900}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource A.Neutral.900}" />
</ResourceDictionary>
