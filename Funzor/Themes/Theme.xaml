<?xml version="1.0" encoding="utf-8"?>

<!--
    主题装配层

    只做 ThemeDictionaries 的接线, 不放任何色值, 也不合并 Tokens.xaml (App.xaml 已经合过一次).

    - Default: 兜底. 平台判定不出主题时使用, WinUI 内置资源里 Default 同样是深色, 这里保持一致.
    - Light / Dark: 指向 Theme.Light.xaml / Theme.Dark.xaml.
    - HighContrast: 暂不定义, 缺失时回退到 Default.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
